{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tooling/scripts/*.ts"],
      "project": ["tooling/**/*.ts"]
    },
    "apps/mobile": {
      "entry": ["src/auth/index.ts", "src/database/index.ts", "src/onboarding/index.ts", "src/services/index.ts"],
      "project": ["**/*.ts", "**/*.tsx"]
    }
  },
  "ignoreIssues": {
    "apps/mobile/src/components/InputBar.tsx": ["types"]
  },
  "ignoreDependencies": ["lint-staged", "@babel/runtime"],
  "ignoreBinaries": ["semgrep", "prettier"]
}
